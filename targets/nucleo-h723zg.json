{
    "inherits": ["cortex-m7"],
    "build-tags": ["nucleoh723zg", "stm32h723", "stm32h7", "stm32"],
    "serial": "uart",
    "linkerscript": "targets/stm32h723xg.ld",
    "extra-files": [
        "src/device/stm32/stm32h723.s"
    ],
    "flash-method": "openocd",
    "openocd-interface": "stlink",
