{
	"inherits": [
		"riscv32"
	],
	"inheritable-only": true,
	"target-abi": "ilp32f",
	"features": "+32bit,+a,+c,+f,+m,+zaamo,+zalrsc,+zmmul,+zicsr,+zifencei,-relax",
	"build-tags": [
		"esp32p4",
		"esp"
	],
	"serial": "uart",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 32768,
	"cflags": [
		"-march=rv32imafc",
		"-mabi=ilp32f",
		"-D__TINYGO_ESP32P4=1"
	],
	"linkerscript": "targets/esp32p4.ld",
	"extra-files": [
		"src/device/esp/esp32p4.S",
		"src/device/esp/esp32p4_psram.S",
		"src/internal/task/task_stack_esp32p4.S"
	],
	"extra-files-exclude": [
		"src/internal/task/task_stack_tinygoriscv.S"
	],
	"binary-format": "esp32p4",
	"flash-method": "esp32flash",
	"serial-port": [
		"303a:1001"
	],
	"openocd-interface": "esp_usb_jtag",
	"openocd-target": "esp32p4",
	"openocd-commands": [
		"gdb_memory_map disable"
	],
	"gdb": [
		"riscv32-esp-elf-gdb"
	]
}
