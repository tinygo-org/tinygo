{
	"inherits": [
		"riscv32"
	],
	"inheritable-only": true,
	"features": "+32bit,+a,+c,+m,+zaamo,+zalrsc,+zmmul,+zicsr,+zifencei,-relax",
	"build-tags": [
		"esp32p4",
		"esp",
		"machine.uart",
		"machine.spi",
		"machine.i2c",
		"machine.psram"
	],
	"serial": "uart",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 32768,
	"linkerscript": "targets/esp32p4.ld",
	"ldflags": [
		"--defsym=__psram_size=32M"
	],
	"extra-files": [
		"src/device/esp/esp32p4.S",
		"src/device/esp/esp32p4_psram.S"
	],
	"binary-format": "esp32p4",
	"flash-method": "esp32flash",
	"serial-port": [
		"303a:1001"
	],
	"openocd-interface": "esp_usb_jtag",
	"openocd-target": "esp32p4",
	"openocd-commands": [
		"gdb_memory_map disable"
	],
	"gdb": [
		"riscv32-esp-elf-gdb"
	]
}
