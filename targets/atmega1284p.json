{
    "inherits": ["avr"],
    "cpu": "atmega1284p",
    "build-tags": ["atmega1284p", "atmega"],
    "serial": "uart",
    "ldflags": [
        "--defsym=_bootloader_size=0",
        "--defsym=_stack_size=512"
    ],
    "linkerscript": "src/device/avr/ATmega1284P.ld",
    "extra-files": [
        "targets/avr.S",
        "src/device/avr/ATmega1284P.s"
    ],
    "emulator": "simavr -m atmega1284p -f 20000000 {}"
}
