#!/usr/bin/env python3

# Small tool to compare code size between TinyGo runs (with the -size=short flag).

import sys

class Comparison:
    def __init__(self, command, flash0, ram0, flash1, ram1):
        self.command = command
        self.flash0 = flash0
        self.ram0 = ram0
        self.flash1 = flash1
        self.ram1 = ram1

    @property
    def ramdiff(self):
        return self.ram1 - self.ram0

    @property
    def flashdiff(self):
        return self.flash1 - self.flash0

def readSizes(path):
    sizes = []
    lines = open(path).readlines()
    command = None
    for i in range(len(lines)):
        if lines[i].strip().startswith('tinygo build'):
            command = lines[i].strip()
        elif lines[i].strip().startswith('code '):
            # found a size header
            code, data, bss, flash, ram = map(int, lines[i+1].replace("|", "").split())
            sizes.append({
                'command': command,
                'flash':   flash,
                'ram':     ram
            })
            command = None # make sure we don't accidentally miss a 'tinygo build' line
    return sizes

def main():
    path0 = sys.argv[1]
    path1 = sys.argv[2]
    sizes0 = readSizes(path0)
    sizes1 = readSizes(path1)
    commands1 = {size['command']: size for size in sizes1}
    commands0 = {size['command'] for size in sizes0}
    comparisons = []
    for size0 in sizes0:
        size1 = commands1.get(size0['command'])
        if size1 is None:
            print('only in %s:' % path0, size0['command'])
            continue
        comparisons.append(Comparison(size0['command'], size0['flash'], size0['ram'], size1['flash'], size1['ram']))
    for size1 in sizes1:
        if size1['command'] not in commands0:
            print('only in %s:' % path1, size1['command'])
    comparisons.sort(key=lambda x: x.flashdiff)
    if not comparisons:
        return
    changed = [c for c in comparisons if c.flashdiff != 0 or c.ramdiff != 0]
    unchanged = len(comparisons) - len(changed)
    if not changed:
        label = 'binary' if len(comparisons) == 1 else 'binaries'
        print('No binary size changes (%d %s).' % (len(comparisons), label))
        return
    totalFlash0 = 0
    totalFlash1 = 0
    totalRam0 = 0
    totalRam1 = 0
    totalDiff = 0
    totalRamDiff = 0
    totalProduct = 1
    totalRamProduct = 1
    print(' flash                          ram')
    print(' before   after   diff          before   after   diff')
    for comparison in comparisons:
        diffPct = comparison.flashdiff / comparison.flash0
        diffRamPct = comparison.ramdiff / comparison.ram0
        if comparison.flashdiff != 0 or comparison.ramdiff != 0:
            print('%7d %7d %6d %6.2f%% %7d %7d %6d %6.2f%% %s' % (comparison.flash0, comparison.flash1, comparison.flashdiff, diffPct * 100, comparison.ram0, comparison.ram1, comparison.ramdiff, diffRamPct * 100, comparison.command))
        totalFlash0 += comparison.flash0
        totalFlash1 += comparison.flash1
        totalDiff += comparison.flashdiff
        totalProduct *= (1 + diffPct)
        totalRam0 += comparison.ram0
        totalRam1 += comparison.ram1
        totalRamDiff += comparison.ramdiff
        totalRamProduct *= (1 + diffRamPct)
    geomean = totalProduct ** (1.0 / float(len(comparisons)))
    geomeanRam = totalRamProduct ** (1.0 / float(len(comparisons)))
    suffix = ' (%d unchanged)' % unchanged if unchanged else ''
    print('%7d %7d %6d %6.2f%% %7d %7d %6d %6.2f%%%s' % (totalFlash0, totalFlash1, totalDiff, geomean - 1, totalRam0, totalRam1, totalRamDiff, geomeanRam - 1, suffix))


if __name__ == '__main__':
    main()
